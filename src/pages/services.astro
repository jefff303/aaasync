---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

// Vos 4 Piliers de Services Rationalisés
const pillars = [
  {
    id: "audit",
    title: "1. Audit & Diagnostic",
    subtitle: "Le Check-Up Digital & Tech",
    description: "Identifiez les freins, sécurisez vos choix techniques et mettez vos applications en conformité avant d'investir.",
    badge: "Accroche & Diagnostic",
    badgeClass: "badge-primary",
    borderClass: "border-primary",
    iconBgClass: "bg-primary/10 text-primary",
    btnClass: "btn-primary",
    icon: "search",
    features: [
      "Audit Flash Existant (Offert)",
      "Conformité RGPD, RGAA (Accessibilité) & Facturation",
      "Audit Cybersécurité & Robustesse d'architecture",
      "Audit Workflow & Opportunités IA"
    ],
    ctaText: "Demander un audit offert",
    ctaLink: "/contact?service=audit"
  },
  {
    id: "studio",
    title: "2. Développement Sur-Mesure",
    subtitle: "Le Studio d'Ingénierie",
    description: "Conception de produits digitaux d'exception. Des applications web et mobiles ultra-performantes et évolutives.",
    badge: "Ingénierie Web & Mobile",
    badgeClass: "badge-secondary",
    borderClass: "border-secondary",
    iconBgClass: "bg-secondary/10 text-secondary",
    btnClass: "btn-secondary",
    icon: "code",
    features: [
      "Business Modeling & Cadrage de besoins",
      "Développement Web & Mobile Next-Gen",
      "Architecture Scalable & Sécurité intégrée",
      "Maintenance & Forfait Sérénité"
    ],
    ctaText: "Lancer un projet",
    ctaLink: "/contact?service=studio"
  },
  {
    id: "ia",
    title: "3. IA & Automatisations",
    subtitle: "Le Lab Workflows Intelligents",
    description: "Gagnez des centaines d'heures. Intégrez l'intelligence artificielle au cœur de vos processus opérationnels.",
    badge: "Productivité & IA",
    badgeClass: "badge-accent",
    borderClass: "border-accent",
    iconBgClass: "bg-accent/10 text-accent",
    btnClass: "btn-accent",
    icon: "cpu",
    features: [
      "Workflows métier automatisés de A à Z",
      "Prompt Engineering & Modèles IA personnalisés",
      "Automatisations Webmarketing & Réseaux sociaux",
      "Intégrations API & Élimination des tâches manuelles"
    ],
    ctaText: "Automatiser vos processus",
    ctaLink: "/contact?service=ia"
  },
  {
    id: "academie",
    title: "4. Formation & Accompagnement",
    subtitle: "L'Académie & CTO-as-a-Service",
    description: "Montez en compétences et faites-vous accompagner par des experts techniques pédagogues sans embaucher à plein temps.",
    badge: "Autonomie & Direction Tech",
    badgeClass: "badge-info",
    borderClass: "border-info",
    iconBgClass: "bg-info/10 text-info",
    btnClass: "btn-info",
    icon: "academic",
    features: [
      "CTO as a Service (Abonnement souple sans engagement)",
      "Formations techniques sur-mesure pour vos équipes",
      "Accompagnement IA pour collaborateurs & développeurs",
      "Mentorat, revue de code & transfert de compétences"
    ],
    ctaText: "Découvrir l'accompagnement",
    ctaLink: "/contact?service=academie"
  }
];

// Étapes de votre accompagnement
const processSteps = [
  {
    number: "1",
    title: "Audit & Diagnostic",
    description: "Nous analysons votre existant, vos contraintes et vos objectifs pour établir un diagnostic clair."
  },
  {
    number: "2",
    title: "Architecture & Stratégie",
    description: "Nous définissons la meilleure approche technique, le cadrage budgétaire et les jalons du projet."
  },
  {
    number: "3",
    title: "Réalisation / Automatisation",
    description: "Nous développons votre solution ou vos automatisations avec les meilleures technologies du marché."
  },
  {
    number: "4",
    title: "Formation & Transfert",
    description: "Nous formons vos équipes pour vous garantir une autonomie totale et une prise en main immédiate."
  }
];
---

<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <BaseHead 
      title={`Nos Services & Expertise | ${SITE_TITLE}`} 
      description="Développement sur-mesure, audits techniques, automatisations IA et formations : découvrez notre gamme complète de services." 
    />
  </head>
  <body>
    <Header />
    
    <!-- Hero Section -->
    <section class="hero bg-gradient-to-r from-primary to-secondary text-primary-content py-20">
      <div class="hero-content text-center">
        <div class="max-w-2xl">
          <span class="badge badge-outline text-primary-content mb-4 p-3 font-semibold uppercase tracking-wider">
            L'Exigence Technique + La Pédagogie
          </span>
          <h1 class="text-4xl md:text-5xl font-extrabold mb-6">
            Nos Domaines d'Expertise
          </h1>
          <p class="text-xl opacity-90 leading-relaxed">
            De l'audit à la réalisation, jusqu'à la formation de vos équipes : des solutions globales pour propulser votre entreprise.
          </p>
        </div>
      </div>
    </section>
    
    <!-- 4 Piliers de Services Section -->
    <section class="py-16 px-4 bg-base-100">
      <div class="container mx-auto max-w-6xl">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {pillars.map(pillar => (
            <div class={`card bg-base-100 border-t-4 ${pillar.borderClass} shadow-xl hover:shadow-2xl transition-all duration-300 flex flex-col justify-between`}>
              <div class="card-body">
                <div class="flex items-center justify-between mb-2">
                  <span class={`badge ${pillar.badgeClass} p-3 font-medium`}>{pillar.badge}</span>
                  <div class={`w-12 h-12 rounded-xl ${pillar.iconBgClass} flex items-center justify-center`}>
                    {pillar.icon === "search" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                      </svg>
                    )}
                    {pillar.icon === "code" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                      </svg>
                    )}
                    {pillar.icon === "cpu" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                    )}
                    {pillar.icon === "academic" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                      </svg>
                    )}
                  </div>
                </div>

                <h3 class="card-title text-2xl font-bold mt-2">{pillar.title}</h3>
                <p class="text-sm font-semibold opacity-70 mb-2">{pillar.subtitle}</p>
                <p class="text-base-content/80 mb-4">{pillar.description}</p>
                
                <div class="divider my-2"></div>
                
                <ul class="space-y-2 mb-6">
                  {pillar.features.map(feature => (
                    <li class="flex items-start text-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success mr-2 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>

                <div class="card-actions justify-start mt-auto pt-4">
                  <a href={pillar.ctaLink} class={`btn ${pillar.btnClass} w-full`}>
                    {pillar.ctaText}
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Notre Approche Hybride Section -->
    <section class="py-16 px-4 bg-base-200">
      <div class="container mx-auto max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold mb-4">Notre Méthodologie en 4 Étapes</h2>
          <p class="text-base-content/70 max-w-2xl mx-auto">
            Une approche combinant rigueur d'ingénierie et transmission de compétences pour garantir la pérennité de vos projets.
          </p>
        </div>
        
        <div class="mb-12">
          <ul class="steps steps-vertical lg:steps-horizontal w-full">
            <li class="step step-primary">Audit</li>
            <li class="step step-primary">Cadrage</li>
            <li class="step step-primary">Réalisation</li>
            <li class="step step-primary">Transmission</li>
          </ul>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {processSteps.map(step => (
            <div class="card bg-base-100 shadow-md hover:shadow-lg transition-shadow">
              <div class="card-body">
                <h3 class="card-title text-lg">
                  <span class="badge badge-primary badge-lg mr-2">{step.number}</span>
                  {step.title}
                </h3>
                <p class="text-base-content/70 text-sm">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- CTA Banner Section -->
    <section class="bg-neutral text-neutral-content py-16">
      <div class="container mx-auto px-4 text-center max-w-3xl">
        <h2 class="text-3xl font-bold mb-4">Un projet en tête ou besoin d'y voir plus clair ?</h2>
        <p class="text-lg mb-8 opacity-80">
          Commencez par un **Audit Flash gratuit**. Nous analysons votre existant et nous vous proposons une feuille de route sans aucun engagement.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="/contact?service=audit" class="btn btn-primary btn-lg">
            Réserver un Audit Gratuit
          </a>
          <a href="/contact" class="btn btn-outline btn-primary btn-lg">
            Discuter de mon projet
          </a>
        </div>
      </div>
    </section>
    
    <!-- Testimonials Section -->
    <section class="py-16 px-4 bg-base-100">
      <div class="container mx-auto max-w-6xl">
        <h2 class="text-3xl font-bold text-center mb-12">Ils nous font confiance</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <div class="card bg-base-100 shadow-lg border border-base-200">
            <div class="card-body">
              <div class="rating rating-sm mb-4">
                <input type="radio" name="rating-1" class="mask mask-star-2 bg-warning" checked />
                <input type="radio" name="rating-1" class="mask mask-star-2 bg-warning" checked />
                <input type="radio" name="rating-1" class="mask mask-star-2 bg-warning" checked />
                <input type="radio" name="rating-1" class="mask mask-star-2 bg-warning" checked />
                <input type="radio" name="rating-1" class="mask mask-star-2 bg-warning" checked />
              </div>
              <p class="text-base-content/80 text-sm mb-6">"L'audit gratuit d'AÅASYNC nous a ouvert les yeux sur plusieurs failles de sécurité et soucis d'accessibilité. Leur travail sur notre application sur-mesure a été impeccable."</p>
              <div class="flex items-center mt-auto">
                <div class="avatar placeholder mr-3">
                  <div class="bg-primary text-primary-content rounded-full w-10">
                    <span class="text-xs font-bold">MC</span>
                  </div>
                </div>
                <div>
                  <h4 class="font-bold text-sm">Marc C.</h4>
                  <p class="text-xs text-base-content/60">Fondateur Tech & SaaS</p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="card bg-base-100 shadow-lg border border-base-200">
            <div class="card-body">
              <div class="rating rating-sm mb-4">
                <input type="radio" name="rating-2" class="mask mask-star-2 bg-warning" checked />
                <input type="radio" name="rating-2" class="mask mask-star-2 bg-warning" checked />
                <input type="radio" name="rating-2" class="mask mask-star-2 bg-warning" checked />
                <input type="radio" name="rating-2" class="mask mask-star-2 bg-warning" checked />
                <input type="radio" name="rating-2" class="mask mask-star-2 bg-warning" checked />
              </div>
              <p class="text-base-content/80 text-sm mb-6">"Leur capacité à automatiser nos workflows internes avec l'IA nous fait gagner plus de 15 heures par semaine. Et en plus, ils ont pris le temps de former toute l'équipe !"</p>
              <div class="flex items-center mt-auto">
                <div class="avatar placeholder mr-3">
                  <div class="bg-secondary text-secondary-content rounded-full w-10">
                    <span class="text-xs font-bold">SL</span>
                  </div>
                </div>
                <div>
                  <h4 class="font-bold text-sm">Sophie L.</h4>
                  <p class="text-xs text-base-content/60">Directrice Opérationnelle</p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="card bg-base-100 shadow-lg border border-base-200">
            <div class="card-body">
              <div class="rating rating-sm mb-4">
                <input type="radio" name="rating-3" class="mask mask-star-2 bg-warning" checked />
                <input type="radio" name="rating-3" class="mask mask-star-2 bg-warning" checked />
                <input type="radio" name="rating-3" class="mask mask-star-2 bg-warning" checked />
                <input type="radio" name="rating-3" class="mask mask-star-2 bg-warning" checked />
                <input type="radio" name="rating-3" class="mask mask-star-2 bg-warning" checked />
              </div>
              <p class="text-base-content/80 text-sm mb-6">"En tant que CTO as a Service, ils gèrent toute notre roadmap technique avec une clarté et une pédagogie rares. Une vraie bouffée d'air frais pour notre entreprise."</p>
              <div class="flex items-center mt-auto">
                <div class="avatar placeholder mr-3">
                  <div class="bg-accent text-accent-content rounded-full w-10">
                    <span class="text-xs font-bold">AR</span>
                  </div>
                </div>
                <div>
                  <h4 class="font-bold text-sm">Antoine R.</h4>
                  <p class="text-xs text-base-content/60">CEO Agency</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
    
    <Footer />
  </body>
</html>